# Modèle de configuration des secrets — CE fichier est versionné.
#
# Usage local :
#   copier ce fichier en `.streamlit/secrets.toml` puis remplacer l'URL.
#   `secrets.toml` est ignoré par git (voir .gitignore).
#
# Usage Streamlit Cloud :
#   ne pas déposer de fichier — coller ce contenu dans
#   Manage app > Settings > Secrets.

# URL publique du backend FastAPI, exposée par ngrok.
# Change à chaque redémarrage de ngrok en version gratuite.
API_URL = "https://xxxxx.ngrok-free.dev"
